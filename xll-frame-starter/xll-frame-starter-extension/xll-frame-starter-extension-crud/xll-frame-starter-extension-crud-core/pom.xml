<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xll.frame.starter</groupId>
        <artifactId>xll-frame-starter-extension-crud</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xll-frame-starter-extension-crud-core</artifactId>
    <description>Frame Starter 扩展模块 - CRUD core模块</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- Crane4j（一个基于注解的，用于完成一切 “根据 A 的 key 值拿到 B，再把 B 的属性映射到 A” 这类需求的字段填充框架） -->
        <dependency>
            <groupId>cn.crane4j</groupId>
            <artifactId>crane4j-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Web 模块 -->
        <dependency>
            <groupId>com.xll.frame.starter</groupId>
            <artifactId>xll-frame-starter-web</artifactId>
        </dependency>

        <!-- 数据访问模块 - 核心模块 -->
        <dependency>
            <groupId>com.xll.frame.starter</groupId>
            <artifactId>xll-frame-starter-data-core</artifactId>
        </dependency>

        <!-- 文件处理模块 - Excel -->
        <dependency>
            <groupId>com.xll.frame.starter</groupId>
            <artifactId>xll-frame-starter-file-excel</artifactId>
        </dependency>

        <!-- API 文档模块 -->
        <dependency>
            <groupId>com.xll.frame.starter</groupId>
            <artifactId>xll-frame-starter-api-doc</artifactId>
        </dependency>
    </dependencies>
</project>